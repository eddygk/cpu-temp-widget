<Window x:Class="CpuTempWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:CpuTempWidget.Controls"
        xmlns:converters="clr-namespace:CpuTempWidget.Converters"
        Title="CPU Temp" Width="280" Height="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="{Binding Topmost}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" Closing="Window_Closing">
    <Window.Resources>
        <converters:TemperatureToBrushConverter x:Key="TempBrush" />
        <SolidColorBrush x:Key="LabelBrush" Color="#99FFFFFF" />
    </Window.Resources>

    <Border CornerRadius="12" Background="#F2101418" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14,8">
        <Border.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Always on top" IsCheckable="False" IsChecked="{Binding Topmost, Mode=OneWay}"
                          Command="{Binding ToggleTopmostCommand}" />
                <MenuItem Header="Refresh rate">
                    <MenuItem Header="1 second" IsChecked="{Binding IsRate1, Mode=OneWay}" Command="{Binding SetIntervalCommand}">
                        <MenuItem.CommandParameter><sys:Int32>1000</sys:Int32></MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="2 seconds" IsChecked="{Binding IsRate2, Mode=OneWay}" Command="{Binding SetIntervalCommand}">
                        <MenuItem.CommandParameter><sys:Int32>2000</sys:Int32></MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="5 seconds" IsChecked="{Binding IsRate5, Mode=OneWay}" Command="{Binding SetIntervalCommand}">
                        <MenuItem.CommandParameter><sys:Int32>5000</sys:Int32></MenuItem.CommandParameter>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: label, current value, window min/max -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource LabelBrush}" />
                <TextBlock FontSize="30" FontWeight="SemiBold"
                           Text="{Binding CurrentTemp, StringFormat='{}{0:0}°C', TargetNullValue='--', FallbackValue='--'}"
                           Foreground="{Binding CurrentTemp, Converter={StaticResource TempBrush}}"
                           ToolTip="{Binding StatusText}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock FontSize="11" Foreground="{StaticResource LabelBrush}"
                               Text="{Binding MaxTemp, StringFormat='▲{0:0}', TargetNullValue='▲--', FallbackValue='▲--'}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource LabelBrush}" Margin="8,0,0,0"
                               Text="{Binding MinTemp, StringFormat='▼{0:0}', TargetNullValue='▼--', FallbackValue='▼--'}" />
                </StackPanel>
            </StackPanel>

            <!-- Right: 5-minute graph with axis labels -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:TemperatureChart Grid.Row="0" Samples="{Binding Samples}" />
                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <TextBlock Text="-5m" FontSize="10" Foreground="{StaticResource LabelBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="now" FontSize="10" Foreground="{StaticResource LabelBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
